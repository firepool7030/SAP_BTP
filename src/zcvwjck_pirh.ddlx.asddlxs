@Metadata.layer: #CORE
@UI: {
  // 화면의 간판 (타이틀)
  headerInfo: {
    typeName: 'PIR 문서',             // 단수형 이름
    typeNamePlural: 'PIR 목록',       // 복수형 이름
    title: { value: 'Pirnr' },      //  
    description: { value: 'Werks' } //
  }
}
annotate view ZCVWJCK_PIRH with
{
  /* ------------------------------------------------------ */
  /* 1. 화면 구조 잡기 (Facet)                               */
  /* ------------------------------------------------------ */
  @UI.facet: [ 
    /* 첫 번째 탭: 기본 정보 (General Info) */
    { 
      id: 'General', 
      purpose: #STANDARD, 
      type: #IDENTIFICATION_REFERENCE, 
      label: '기본 정보', 
      position: 10 
    },
    /* 두 번째 탭: 아이템 리스트 (Items) */
    { 
      id: 'Items', 
      purpose: #STANDARD, 
      type: #LINEITEM_REFERENCE, 
      label: '아이템 목록', 
      position: 20, 
      targetElement: '_PIRI' // <-- 중요! 자식(Item) 뷰의 Alias를 적어야 연결됨
    } 
  ]

  /* ------------------------------------------------------ */
  /* 2. 필드별 배치 (List & Detail)                          */
  /* ------------------------------------------------------ */
  
  /* PIR 번호 */
  @UI: { 
    lineItem:       [{ position: 10, importance: #HIGH }], // 리스트 화면 순서
    identification: [{ position: 10 }],                    // 상세 화면 순서
    selectionField: [{ position: 10 }]                     // 검색 필터(상단 조회조건) 순서
  }
  pirnr;

  /* 플랜트 */
  @UI: { 
    lineItem:       [{ position: 20, importance: #HIGH }], 
    identification: [{ position: 20 }],
    selectionField: [{ position: 20 }] 
  }
  werks;

  /* 계획일자 */
  @UI: { 
    lineItem:       [{ position: 30 }], 
    identification: [{ position: 30 }] 
  }
  pirdt;
  
  /* 문서 생성일 (상세 화면에만 표시) */
  @UI: { 
    identification: [{ position: 40 }] 
  }
  erdat;
  
  /* 문서 생성자 (상세 화면에만 표시) */
  @UI: { 
    identification: [{ position: 50 }] 
  }
  ernam;
  
  /* 삭제 플래그 (중요하지 않으니 리스트에선 숨김) */
  @UI: { 
    identification: [{ position: 99 }] 
  }
  pirdel;
}