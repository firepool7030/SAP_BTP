@Metadata.layer: #CUSTOMER
annotate entity ZDVCK_PIRH with
{
  /* 상세 페이지의 구성을 결정하는 부분(Facets) */
  @UI.facet: [
    { id: 'HeaderInfo',  purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE, label: 'Header Info', position: 10 },
    { id: 'ItemLine',    purpose: #STANDARD, type: #LINEITEM_REFERENCE,      label: 'Line Item Info', position: 20, targetElement: '_Items' }
  ]

  /* 목록 화면과 상세 화면에 보일 필드 지정 */
  @UI: { lineItem:       [{ position: 10, label: 'PIR 문서번호' }],
         identification: [{ position: 10, label: 'PIR 문서번호' }],
         selectionField: [{ position: 10 }] }
  pirnr;

  @UI: { lineItem:       [{ position: 20, label: '플랜트' }],
         identification: [{ position: 20, label: '플랜트' }],
         selectionField: [{ position: 20 }] }
  werks;

  @UI: { lineItem:       [{ position: 30, label: 'PIR 계획일자' }],
         identification: [{ position: 30, label: 'PIR 계획일자' }],
         selectionField: [{ position: 30 }] }
  pirdt;

  @UI: { lineItem:       [{ position: 40, label: 'PIR 계획버전' }],
         identification: [{ position: 40, label: 'PIR 계획버전' }] }
  pirvr;

  @UI: { lineItem:       [{ position: 50, label: 'AI 모델' }],
         identification: [{ position: 50, label: 'AI 모델' }] }
  aimod;
  
  @UI: { lineItem:       [{ position: 60, label: 'AI 예측일자' }],
         identification: [{ position: 60, label: 'AI 예측일자' }] }
  aidat;
  
  @UI: { lineItem:       [{ position: 70, label: '문서 생성일' }],
         identification: [{ position: 70, label: '문서 생성일' }] }
  erdat;

  @UI: { lineItem:       [{ position: 80, label: '문서 생성자' }],
         identification: [{ position: 80, label: '문서 생성자' }] }
  ernam;
  
  @UI: { lineItem:       [{ position: 90, label: 'PIR 문서상태' }],
         identification: [{ position: 90, label: 'PIR 문서상태' }] }
  pirart;
  
  @UI: { lineItem:       [{ position: 100, label: '삭제플래그' }],
         identification: [{ position: 100, label: '삭제플래그' }] }
  pirdel;
}