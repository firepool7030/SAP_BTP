projection;
strict ( 2 );
use draft;

define behavior for ZPVCK_PIRH alias PIR_Header
{
  use create;
  use update;
  use delete;

  use association _Items { create; with draft;}
  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
}

define behavior for ZPVCK_PIRI alias PIR_Item
{
  use update;
  use delete;

  use association _Header { with draft; }
}